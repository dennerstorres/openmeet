# Placeholders only. Do not put a real secret here.
# Upstream `livekit-server --dev` uses its own local dev pair. See docs/POC_F02.md.
# Set POC_JOIN to 1 only in an untracked local .env. Leave it unset to keep the route hidden.
POC_JOIN=
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=replace-with-local-dev-key
LIVEKIT_API_SECRET=replace-with-local-dev-secret
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
# Optional local Postgres. Leave empty: the API does not connect on boot.
DATABASE_URL=
# HMAC secret for access tokens, at least 32 characters. Leave empty until auth is configured.
AUTH_SECRET=
# One-time install token, at least 20 characters. Consumed by the first admin bootstrap.
BOOTSTRAP_TOKEN=
