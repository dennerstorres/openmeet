{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMeet",
  "version": "0.1.0",
  "identifier": "com.openmeet.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenMeet",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:3000 http://localhost:3000 ws://127.0.0.1:7880 ws://localhost:7880 wss: https://livekit.dennerstorres.dev",
        "media-src": "'self' blob: mediastream:",
        "img-src": "'self' blob: data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
