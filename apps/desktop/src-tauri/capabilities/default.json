{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. S-14: only the core calls the page makes, never core:default.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:webview:deny-internal-toggle-devtools",
    "allow-session-load",
    "allow-session-save",
    "allow-session-clear",
    "allow-shell-status",
    "allow-shell-set-consent",
    "allow-shell-tracks",
    "allow-shell-show",
    "allow-invite-take",
    "allow-open-google-login"
  ]
}
