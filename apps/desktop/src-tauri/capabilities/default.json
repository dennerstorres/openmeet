{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. S-14: only the core calls the page makes, never core:default.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:webview:deny-internal-toggle-devtools",
    "allow-session-login",
    "allow-session-bootstrap",
    "allow-session-google",
    "allow-session-refresh",
    "allow-session-logout",
    "allow-instance-call",
    "allow-instance-image",
    "allow-instance-sound",
    "allow-instance-emoji",
    "allow-instance-attachment",
    "allow-instance-attachment-save",
    "allow-instance-events-open",
    "allow-instance-events-close",
    "allow-shell-status",
    "allow-shell-set-consent",
    "allow-shell-set-autostart",
    "allow-shell-tracks",
    "allow-shell-show",
    "allow-shell-notify",
    "allow-shell-badge",
    "allow-invite-take",
    "allow-open-google-login",
    "allow-open-chat-link",
    "allow-update-check",
    "allow-update-install"
  ]
}
